// Karkain CRM - Round 2 customer lifecycle, history and relationship summary.
// Self-contained module: reads data/r2_crm.dat, rebuilds state from scratch on
// every run (safe to repeat), and persists to data/r2_crm_state.dat /
// data/r2_crm_report.dat. Round 1 sources, state and output are untouched.
//
// Stages: LEAD / QUALIFIED / CUSTOMER / CHURNED.
// Allowed transitions: LEAD>QUALIFIED, LEAD>CHURNED, QUALIFIED>CUSTOMER,
// QUALIFIED>CHURNED, CUSTOMER>CHURNED. CHURNED is terminal.

func r2_cust_index(state, id) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "CUSTOMER") {
            if (f[1] == id) { return i }
        }
        i = i + 1
    }
    return -1
}

func r2_count_linked(state, kind, id) {
    let n = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == kind) {
            if (f[1] == id) { n = n + 1 }
        }
        i = i + 1
    }
    return n
}

func r2_count(state, kind) {
    let n = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == kind) { n = n + 1 }
        i = i + 1
    }
    return n
}

func r2_persist(path, state) {
    let out = ""
    let i = 0
    while (i < len(state)) {
        out = out + state[i] + "\n"
        i = i + 1
    }
    writeFile(path, out)
}

public func crm2_run() {
    let stages = "LEAD|QUALIFIED|CUSTOMER|CHURNED"
    let allowed = "LEAD>QUALIFIED|LEAD>CHURNED|QUALIFIED>CUSTOMER|QUALIFIED>CHURNED|CUSTOMER>CHURNED"
    let cmds = split(readFile("data/r2_crm.dat"), "\n")
    let state = []
    let report = ""
    let i = 0
    while (i < len(cmds)) {
        let line = trim(cmds[i])
        if (line != "") {
            let f = split(line, "|")
            let op = trim(f[0])
            if (op == "CUSTOMER") {
                let id = trim(f[1])
                let name = trim(f[2])
                if (r2_cust_index(state, id) == -1) {
                    push(state, "CUSTOMER|" + id + "|" + name + "|LEAD")
                    let msg = "CUSTOMER " + id + " " + name + " stage=LEAD"
                    print("CRM2 " + msg)
                    report = report + "CRM2 " + msg + "\n"
                }
            }
            if (op == "CONTACT") {
                let id = trim(f[1])
                let name = trim(f[2])
                if (r2_cust_index(state, id) == -1) {
                    push(state, "ERROR|" + id + "|unknown_customer|-")
                    print("CRM2 CONTACT " + id + " FAIL unknown_customer")
                } else {
                    let seq = r2_count_linked(state, "CHIST", id) + 1
                    push(state, "CHIST|" + id + "|" + str(seq) + "|" + name)
                    let msg = "CONTACT " + id + " seq=" + str(seq) + " " + name
                    print("CRM2 " + msg)
                    report = report + "CRM2 " + msg + "\n"
                }
            }
            if (op == "ACTIVITY") {
                let id = trim(f[1])
                let stage = trim(f[2])
                let note = trim(f[3])
                let idx = r2_cust_index(state, id)
                if (idx == -1) {
                    push(state, "ERROR|" + id + "|unknown_customer|-")
                    print("CRM2 ACTIVITY " + id + " FAIL unknown_customer")
                } else {
                    if (contains(stages, stage) == 0) {
                        push(state, "ERROR|" + id + "|invalid_stage|-")
                        print("CRM2 ACTIVITY " + id + " FAIL invalid_stage=" + stage)
                    } else {
                        let cur = split(state[idx], "|")[3]
                        if (cur != stage) {
                            push(state, "ERROR|" + id + "|stage_mismatch|-")
                            print("CRM2 ACTIVITY " + id + " FAIL stage_mismatch want=" + cur + " got=" + stage)
                        } else {
                            let seq = r2_count_linked(state, "ACT", id) + 1
                            push(state, "ACT|" + id + "|" + str(seq) + "|" + stage + "|" + note)
                            let msg = "ACTIVITY " + id + " seq=" + str(seq) + " stage=" + stage + " " + note
                            print("CRM2 " + msg)
                            report = report + "CRM2 " + msg + "\n"
                        }
                    }
                }
            }
            if (op == "STAGE") {
                let id = trim(f[1])
                let to = trim(f[2])
                let idx = r2_cust_index(state, id)
                if (idx == -1) {
                    push(state, "ERROR|" + id + "|unknown_customer|-")
                    print("CRM2 STAGE " + id + " FAIL unknown_customer")
                } else {
                    if (contains(stages, to) == 0) {
                        push(state, "ERROR|" + id + "|invalid_stage|-")
                        print("CRM2 STAGE " + id + " FAIL invalid_stage=" + to)
                    } else {
                        let rec = split(state[idx], "|")
                        let from = rec[3]
                        if (contains(allowed, from + ">" + to) == 0) {
                            push(state, "ERROR|" + id + "|invalid_transition|-")
                            print("CRM2 STAGE " + id + " FAIL invalid_transition " + from + ">" + to)
                        } else {
                            let seq = r2_count_linked(state, "SHIST", id) + 1
                            push(state, "SHIST|" + id + "|" + str(seq) + "|" + from + "|" + to)
                            state[idx] = "CUSTOMER|" + id + "|" + rec[2] + "|" + to
                            let msg = "STAGE " + id + " seq=" + str(seq) + " " + from + ">" + to
                            print("CRM2 " + msg)
                            report = report + "CRM2 " + msg + "\n"
                        }
                    }
                }
            }
            if (op == "SUMMARY") {
                let k = 0
                while (k < len(state)) {
                    let c = split(state[k], "|")
                    if (c[0] == "CUSTOMER") {
                        let id = c[1]
                        let contacts = r2_count_linked(state, "CHIST", id)
                        let activities = r2_count_linked(state, "ACT", id)
                        let transitions = r2_count_linked(state, "SHIST", id)
                        let msg = "SUMMARY id=" + id + " name=" + c[2] + " stage=" + c[3] + " contacts=" + str(contacts) + " activities=" + str(activities) + " transitions=" + str(transitions)
                        print("CRM2 " + msg)
                        report = report + "CRM2 " + msg + "\n"
                    }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    r2_persist("data/r2_crm_state.dat", state)
    r2_persist("data/r2_crm_report.dat", split(report, "\n"))
    print("CRM2_OK customers=" + str(r2_count(state, "CUSTOMER")) + " contacts=" + str(r2_count(state, "CHIST")) + " activities=" + str(r2_count(state, "ACT")) + " transitions=" + str(r2_count(state, "SHIST")) + " errors=" + str(r2_count(state, "ERROR")))
}
